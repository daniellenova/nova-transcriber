POSTGRES_DB=nova_transcriber
POSTGRES_USER=nova_transcriber

# Задайте собственный пароль перед запуском PostgreSQL
POSTGRES_PASSWORD=

# Токен от @BotFather и числовой ID единственного разрешённого пользователя
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Максимальный размер файла в МиБ (1 МиБ = 1 048 576 байт)
MAX_FILE_SIZE_MB=100

# Часовой пояс для отображения истории и логов
DISPLAY_TIMEZONE=Europe/Moscow

# Внутренний Core API: случайный секрет от 32 символов
CORE_API_TOKEN=

# Данные приложения с https://my.telegram.org/apps для локального Bot API
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
