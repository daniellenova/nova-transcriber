POSTGRES_DB=nova_transcriber
POSTGRES_USER=nova_transcriber
# Задайте собственный пароль перед запуском PostgreSQL.
POSTGRES_PASSWORD=

# Для вызовов database.py на хосте экспортируйте эти переменные в окружение.
# Compose задаёт PGHOST=postgres и PGPORT=5432 внутри контейнера приложения.
PGHOST=localhost
PGPORT=5432
PGDATABASE=${POSTGRES_DB}
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
